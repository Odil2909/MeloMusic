# Jamendo client id. Set a registered application id in your deployment environment.
JAMENDO_CLIENT_ID=

# Neon values are pulled by `npx neon@latest deploy` after `neon login`.
# Pooled for runtime Prisma Client; direct/unpooled for Prisma CLI migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Generate once with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
